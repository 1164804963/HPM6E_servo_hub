# Keep the shared SDK untouched; compile this project's corrected loop copy.
set(_mcl_loop_source "$ENV{HPM_SDK_BASE}/middleware/hpm_mcl_v2/core/loop/hpm_mcl_loop.c")
get_target_property(_mcl_sources ${HPM_SDK_LIB} SOURCES)
list(FIND _mcl_sources "${_mcl_loop_source}" _mcl_source_index)
if(_mcl_source_index EQUAL -1)
    message(FATAL_ERROR "MCL loop source missing from SDK target; review mcl-loop-fix.cmake")
endif()
file(READ "${_mcl_loop_source}" _mcl_loop_text)
set(_mcl_bad "uq += sens_speed * (*loop->encoder->pole_num) * (*loop->ld * sens_q + *loop->flux);")
set(_mcl_good "uq += sens_speed * (*loop->encoder->pole_num) * (*loop->ld * sens_d + *loop->flux);")
string(FIND "${_mcl_loop_text}" "${_mcl_bad}" _mcl_bad_index)
string(FIND "${_mcl_loop_text}" "${_mcl_good}" _mcl_good_index)
if(_mcl_bad_index GREATER_EQUAL 0)
    string(REPLACE "${_mcl_bad}" "${_mcl_good}" _mcl_loop_text "${_mcl_loop_text}")
elseif(_mcl_good_index EQUAL -1)
    message(FATAL_ERROR "MCL dq formula changed; review mcl-loop-fix.cmake")
endif()
# Preserve the archive member name: the SDK uses ar crD, which retains removed members.
set(_mcl_fixed "${CMAKE_CURRENT_BINARY_DIR}/generated/hpm_mcl_loop.c")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated")
file(WRITE "${_mcl_fixed}" "${_mcl_loop_text}")
list(REMOVE_ITEM _mcl_sources "${_mcl_loop_source}")
set_property(TARGET ${HPM_SDK_LIB} PROPERTY SOURCES "${_mcl_sources}")
sdk_src("${_mcl_fixed}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_mcl_loop_source}")
message(STATUS "MCL dq fix: q-axis feedforward uses Id")
